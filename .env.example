APP_ENV=local
APP_NAME=stock-platform
APP_TIMEZONE=Asia/Seoul

LOG_LEVEL=INFO
# 쉼표 구분. 운영에서는 localhost 단독 불가
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=stock_platform
# DB_USER=stock_app
# DB_PASSWORD=change-me
# STEP58 — Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# 키움 REST (모의투자 기본)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_USE_MOCK=true
KIWOOM_LIVE_ORDER_ENABLED=false
KIWOOM_TIMEOUT_SECONDS=10
KIWOOM_HTTP_TIMEOUT_SECONDS=10
KIWOOM_MAX_REQUESTS_PER_SECOND=5
KIWOOM_ACCOUNT_NUMBER=
# 로컬/모의에서는 false 권장 (mock WS handshake 실패·429 소음 방지)
KIWOOM_RECOVERY_START_WS=false
KIWOOM_RECOVERY_START_TRADING=false
KIWOOM_RECOVERY_START_SCHEDULER=true

# 키움 WebSocket
KIWOOM_WS_URL=
KIWOOM_WS_PATH=/api/dostk/websocket
KIWOOM_WS_EXECUTION_TYPE=00
KIWOOM_WS_RECONNECT_MIN_SECONDS=1
KIWOOM_WS_RECONNECT_MAX_SECONDS=30
KIWOOM_WS_MAX_CONSECUTIVE_FAILURES=8
KIWOOM_WS_PING_INTERVAL_SECONDS=20
KIWOOM_WS_PING_TIMEOUT_SECONDS=10
KIWOOM_ORDER_WS_URL=
KIWOOM_ORDER_WS_PATH=
KIWOOM_ORDER_WS_SUBSCRIBE_JSON=

UPBIT_BASE_URL=https://api.upbit.com
UPBIT_TIMEOUT_SECONDS=10
UPBIT_MAX_REQUESTS_PER_SECOND=8
# Private API (잔고). 평문 env만 — DB에 시크릿 저장 금지
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# true면 private 호출 대신 mock 스냅샷 (로컬/CI 기본)
UPBIT_USE_MOCK=true
# STEP 8-9C — 운영 Dry-run 준비 시 false. 조회(인증/잔고/미체결/시세/호가)만 허용.
# 주문·취소·ARM·LIVE ON은 별도 승인 STEP에서만.
# UPBIT_USE_MOCK=false
# 실주문은 이중 게이트: GLOBAL + UPBIT_LIVE 모두 true
UPBIT_LIVE_ORDER_ENABLED=false
# LIVE Outbox Worker — enabled=준비, auto_start=기동 시 polling(기본 OFF)
LIVE_OUTBOX_WORKER_ENABLED=false
LIVE_OUTBOX_WORKER_AUTO_START=false
# Upbit 공개시세 기본 심볼 (shadow auto-start와 독립)
REALTIME_UPBIT_DEFAULT_SYMBOL=KRW-XRP
REALTIME_UPBIT_SHADOW_AUTO_START_ENABLED=false
# STEP 8-9C — UPBIT UBA 생성 시 계좌 Risk 권장 오버레이(시스템 전역 기본과 별개)
# max_order_amount=5000 / max_open_orders=1 / daily_order_limit=1
# (Admin API: POST /admin/broker-accounts , apply-recommended-risk)
# STEP 8-9 — 업비트 소액 LIVE 스모크 (기본 dry-run, 실주문 별도 승인)
UPBIT_LIVE_PREFLIGHT_TTL_SECONDS=30
UPBIT_LIVE_SMOKE_ALLOWLIST=KRW-BTC,KRW-ETH,KRW-XRP
UPBIT_LIVE_SMOKE_ORDER_WATCH_SECONDS=60
UPBIT_LIVE_SMOKE_AUTO_CANCEL=true
UPBIT_LIVE_SMOKE_DEFAULT_AMOUNT=5000
UPBIT_LIVE_SMOKE_MAX_AMOUNT=10000
# STEP 8-9A — Broker 추적 Scheduler (거래 Scheduler와 분리)
UPBIT_LIVE_TRACK_ENABLED=true
UPBIT_LIVE_TRACK_POLL_SECONDS=2
UPBIT_LIVE_TRACK_RETRY_DELAYS_SECONDS=1,2,5,10,20
UPBIT_LIVE_TRACK_MAX_ATTEMPTS=8
# 허용 마켓 화이트리스트(쉼표). 비우면 제한 없음
UPBIT_ALLOWED_MARKETS=
# broker_account_snapshot.account_number 식별자
UPBIT_ACCOUNT_REF=MAIN
# STEP 8-5-8 — Upbit Rate Limit / Retry-After
UPBIT_RETRY_MAX_ATTEMPTS_READ=4
UPBIT_RETRY_MAX_ATTEMPTS_WRITE=1
UPBIT_RETRY_BASE_DELAY_SECONDS=1
UPBIT_RETRY_MAX_DELAY_SECONDS=60
UPBIT_RETRY_JITTER_RATIO=0.2
UPBIT_RETRY_AFTER_MAX_SECONDS=300
UPBIT_RATE_LIMIT_COOLDOWN_PERSIST_SECONDS=10
UPBIT_418_DEFAULT_BLOCK_SECONDS=600
UPBIT_RATE_LIMIT_COORDINATOR_ENABLED=true

# 실거래 전역 게이트 (키움/업비트 LIVE와 AND)
GLOBAL_LIVE_ORDER_ENABLED=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# STEP69 — 사용자 공시 AI 요약 (비우면 OLLAMA_MODEL 사용)
AI_DISCLOSURE_SUMMARY_MODEL=
AI_DISCLOSURE_SUMMARY_PROMPT_VERSION=v1
AI_DISCLOSURE_SUMMARY_COOLDOWN_SECONDS=30
AI_DISCLOSURE_SUMMARY_MAX_PER_MINUTE=10
# STEP70 — 사용자 AI 종목 추천 (비우면 OLLAMA_MODEL)
AI_RECOMMENDATION_MODEL=
AI_RECOMMENDATION_PROMPT_VERSION=v1
AI_RECOMMENDATION_COOLDOWN_SECONDS=60
AI_RECOMMENDATION_MAX_PER_MINUTE=5
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m

# STEP 11-1 — AI Provider Framework (자동매매/전략생성 없음, Mock 기본)
AI_PROVIDER_MOCK_ENABLED=true
AI_PROVIDER_MOCK_DEFAULT=true
AI_PROVIDER_MOCK_PRIORITY=10
AI_PROVIDER_MOCK_MODEL=mock-v1
AI_PROVIDER_MOCK_SIGNAL=HOLD
AI_PROVIDER_MOCK_LATENCY_MS=5
AI_PROVIDER_MOCK_SIMULATE_ERROR=false
AI_PROVIDER_MOCK_SIMULATE_TIMEOUT=false
AI_PROVIDER_OPENAI_ENABLED=false
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_CLAUDE_ENABLED=false
AI_PROVIDER_CLAUDE_API_KEY=
AI_PROVIDER_GEMINI_ENABLED=false
AI_PROVIDER_GEMINI_API_KEY=
AI_PROVIDER_OLLAMA_ENABLED=false
# AUTO LIVE AI Signal Gate (기본 OFF). LIVE에서 STALE/장애 시 HOLD
AUTOTRADING_AI_SIGNAL_GATE_ENABLED=false
AUTOTRADING_AI_SIGNAL_GATE_LIVE_ENABLED=false
AUTOTRADING_AI_SIGNAL_GATE_SHADOW_ENABLED=true
AUTOTRADING_AI_ANALYSIS_TTL_SECONDS=900
AUTOTRADING_AI_LIVE_FAIL_CLOSED=true
AUTOTRADING_AI_MIN_CONFIDENCE=0.4
AUTOTRADING_AI_REDUCE_RATIO=0.5
# UPBIT AI Market Analysis 주기 Job (Gate ON과 분리)
AUTOTRADING_AI_ANALYSIS_ENABLED=false
AUTOTRADING_AI_ANALYSIS_INTERVAL_SECONDS=300
AUTOTRADING_AI_ANALYSIS_SYMBOL=KRW-XRP
AUTOTRADING_AI_ANALYSIS_TIMEFRAME=1m
AUTOTRADING_AI_ANALYSIS_PROVIDER=ollama
AUTOTRADING_AI_ANALYSIS_MODEL=qwen3.5:4b
AUTOTRADING_AI_ANALYSIS_TIMEOUT_SECONDS=150
AUTOTRADING_AI_ANALYSIS_WARMUP_ENABLED=true
AI_PROVIDER_OPENAI_COMPATIBLE_ENABLED=false
AI_PROVIDER_OPENAI_COMPATIBLE_ENDPOINT=
AI_PROVIDER_OPENAI_COMPATIBLE_ALLOW_LOCALHOST=true
# STEP 11-3 — Credential Vault는 Broker와 동일 Master Key 파일 사용
# (DB 설정이 Source of Truth. env Key는 bootstrap/비상용, 자동 DB 복사 금지)
# BROKER_VAULT_MASTER_KEY_FILE=E:\StockTrading\secrets\broker-vault-master.key
# 운영자 수동 Test/Verify만 실호출 — 기본 pytest는 live_ai Marker 제외
# 개발: env bootstrap 가능 / 운영: DB SoT, Fail Closed 시 Mock only

DART_API_KEY=
DART_BASE_URL=https://opendart.fss.or.kr/api
DART_TIMEOUT_SECONDS=60

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_BASE_URL=https://openapi.naver.com/v1/search/news.json
NAVER_NEWS_TIMEOUT_SECONDS=15

REALTIME_STRATEGY_MARKET_CODE=KRX
REALTIME_STRATEGY_SYMBOL=
# 실시간 Paper 실행 / 대시보드 기본 계좌 (하드코딩 1 대체)
REALTIME_PAPER_ACCOUNT_ID=1
# STEP 8-5-9 — Realtime Hub / Scope Registry
REALTIME_HUB_ENABLED=true
REALTIME_AUTO_CONNECT=true
REALTIME_EVENT_MAX_AGE_SECONDS=10
REALTIME_RECONNECT_BASE_SECONDS=1
REALTIME_RECONNECT_MAX_SECONDS=60
REALTIME_RECONNECT_JITTER_RATIO=0.2
REALTIME_SIGNAL_COOLDOWN_SECONDS=30
REALTIME_WARMUP_TIMEOUT_SECONDS=60
REALTIME_MAX_SCOPES_PER_SYMBOL=100
STRATEGY_AUTO_DEPLOY_ENABLED=false
PAPER_STRATEGY_AUTO_STOP_ENABLED=false

# 백업 디렉터리 (상대경로 권장 — 머신 고정 경로 지양)
BACKUP_DIR=backups
# 선택: ENV 파일 절대경로 오버라이드
# STOCK_PLATFORM_ENV_FILE=

# 알림 (선택)
APP_VERSION=1.1.0
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# 관리 API 보호 (서버 전용 — 프론트 NEXT_PUBLIC 에 넣지 말 것)
# 운영(prod/staging): ADMIN_API_KEY 필수 (미설정 시 기동 실패, DEV_OPEN 제거됨)
# 로컬: 비워둘 수 있으나 require_admin 은 JWT admin 또는 키 필요
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# JWT 인증 (Admin Web 로그인)
# Secret은 E:\StockTrading\secrets\stock-platform.env 에만 두고 Git에 커밋하지 말 것
# ---------------------------------------------------------------------------
# STEP 8-5-2 — Broker Credential Vault Master Key (파일 경로만, 원문 금지)
# 생성: ops/generate_broker_vault_key.ps1
# BROKER_VAULT_MASTER_KEY_FILE=E:\StockTrading\secrets\broker-vault-master.key
# ---------------------------------------------------------------------------
# 운영(prod): JWT_SECRET 필수
# 개발(local): JWT_SECRET 비어 있고 JWT_DEV_AUTO_SECRET=true 이면 기동 시 임시 Secret 생성
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_DEV_AUTO_SECRET=true
# 사용자가 0명일 때만 최초 관리자 생성
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# 로그인 실패 잠금
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# HttpOnly refresh cookie (동일 사이트/credentials 필요). 기본 false
AUTH_REFRESH_COOKIE_ENABLED=false

SCHEDULER_ENABLED=true
# API lifecycle cron (일손실·전략 등). AutomaticScheduler와 별개
LIFECYCLE_SCHEDULER_ENABLED=true
# 다중 API replica 시 true → PG advisory lock 리더만 lifecycle cron
SCHEDULER_LEADER_LOCK_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_CANDIDATE_HOUR=16
SCHEDULER_CANDIDATE_MINUTE=10
SCHEDULER_AI_HOUR=16
SCHEDULER_AI_MINUTE=30
SCHEDULER_POSITION_HOUR=17
SCHEDULER_POSITION_MINUTE=0
# STEP66 — 장후 포트폴리오 자산 스냅샷
SCHEDULER_EQUITY_SNAPSHOT_HOUR=15
SCHEDULER_EQUITY_SNAPSHOT_MINUTE=40
SCHEDULER_EXCHANGE_CODE=KRX
SCHEDULER_CANDIDATE_LIMIT=30
SCHEDULER_MINIMUM_SCORE=50
SCHEDULER_AI_LIMIT=10
SCHEDULER_POSITION_LIMIT=5
SCHEDULER_POLICY_ID=1
SCHEDULER_PORTFOLIO_VALUE=10000000
SCHEDULER_AVAILABLE_CASH=5000000
SCHEDULER_MINIMUM_AI_SCORE=70
SCHEDULER_MINIMUM_CONFIDENCE=0.5

# STEP53 — Position Exit Monitor (Polling)
POSITION_EXIT_MONITOR_ENABLED=true
POSITION_EXIT_MONITOR_INTERVAL_SECONDS=5
POSITION_EXIT_STOP_LOSS_RATIO=0.05
POSITION_EXIT_TAKE_PROFIT_RATIO=0.10
POSITION_EXIT_TRAILING_STOP_RATIO=0.03
POSITION_EXIT_RELATIVE_LOSS_RATIO=0.08

# STEP 8-5-3 — Broker Recovery Scheduler (lifecycle APScheduler)
RECOVERY_SCHEDULER_ENABLED=true
RECOVERY_SCHEDULER_STARTUP_COOLDOWN_SECONDS=120

# STEP 8-5-6 — PostgreSQL Distributed Recovery Lock (Redis 미사용)
RECOVERY_DISTRIBUTED_LOCK_ENABLED=true
RECOVERY_LOCK_LEASE_SECONDS=120
RECOVERY_LOCK_HEARTBEAT_SECONDS=30
RECOVERY_LOCK_ACQUIRE_TIMEOUT_SECONDS=5
RECOVERY_LOCK_NAMESPACE=stock-platform-recovery

# STEP 8-5-7 — KRX Trading Calendar (운영에서 WEEKDAY_FALLBACK 금지)
KRX_CALENDAR_ALLOW_WEEKDAY_FALLBACK=false
KRX_CALENDAR_REQUIRED_FUTURE_DAYS=60
KRX_CALENDAR_SYNC_ENABLED=true
KRX_CALENDAR_STALE_AFTER_DAYS=30
# STEP 8-5-11 — 동일 ADMIN 요청·승인 허용(소규모). true면 분리 필수
KRX_CALENDAR_REQUIRE_SEPARATE_APPROVER=false
# Calendar 메모리 Cache TTL(초). 다중 인스턴스 최대 지연 ≈ TTL
KRX_CALENDAR_CACHE_TTL_SECONDS=2.0

# STEP 8-5-13 — KRX Trading Session Timeline / Phase Offsets(분)
KRX_PREOPEN_MINUTES_BEFORE_OPEN=30
KRX_RECOVERY_PREOPEN_MINUTES_BEFORE_OPEN=30
KRX_NEW_ENTRY_CUTOFF_MINUTES_BEFORE_CLOSE=10
KRX_RECOVERY_POSTCLOSE_MINUTES_AFTER_CLOSE=10
KRX_SNAPSHOT_MINUTES_AFTER_CLOSE=10
KRX_SETTLEMENT_MINUTES_AFTER_CLOSE=20
KRX_AI_ANALYSIS_MINUTES_AFTER_CLOSE=30
KRX_DYNAMIC_SESSION_JOBS_ENABLED=true
# 08:30/15:40 고정 Cron이 지연개장/조기종료와 어긋날 때 Skip 허용범위
KRX_CRON_FALLBACK_ENABLED=true
KRX_CRON_FALLBACK_EARLY_TOLERANCE_MINUTES=5
KRX_CRON_FALLBACK_LATE_TOLERANCE_MINUTES=60
# PAPER 주식(KRX) 주문도 KRX Session Timeline을 따를지 (LIVE는 항상 적용)
PAPER_STOCK_FOLLOW_KRX_CALENDAR=true

# STEP 8-5-15 — 영속 Market Session Job (DB Claim 기반 Dispatcher/Reconcile)
MARKET_SESSION_JOB_ENABLED=true
MARKET_SESSION_JOB_DISPATCHER_POLL_SECONDS=5
MARKET_SESSION_JOB_BATCH_SIZE=20
MARKET_SESSION_JOB_CLAIM_SECONDS=120
MARKET_SESSION_JOB_RECONCILE_ENABLED=true
MARKET_SESSION_JOB_RECONCILE_INTERVAL_SECONDS=300
MARKET_SESSION_JOB_RECONCILE_DAYS_AHEAD=7
MARKET_SESSION_JOB_MAX_ATTEMPTS=3
MARKET_SESSION_JOB_RETRY_BASE_SECONDS=30
MARKET_SESSION_JOB_RETRY_MAX_SECONDS=600
MARKET_SESSION_JOB_RETENTION_DAYS=90
MARKET_SESSION_JOB_RUN_RETENTION_DAYS=90

# STEP 8-5-16 — EOD Account Settlement
SETTLEMENT_ENABLED=true
SETTLEMENT_MAX_ATTEMPTS=3
SETTLEMENT_RETRY_BASE_SECONDS=60
SETTLEMENT_RETRY_MAX_SECONDS=900
SETTLEMENT_POSITION_VALUE_TOLERANCE_KRW=10
SETTLEMENT_AVERAGE_PRICE_TOLERANCE_KRW=1
SETTLEMENT_CASH_TOLERANCE_KRW=10

# STEP 8-8A — Post-Fill 재검증
POST_FILL_VERIFY_ENABLED=true
POST_FILL_VERIFY_POLL_SECONDS=2
POST_FILL_VERIFY_BATCH_SIZE=20
POST_FILL_VERIFY_CLAIM_SECONDS=30
POST_FILL_VERIFY_MAX_ATTEMPTS=5
POST_FILL_VERIFY_TTL_SECONDS=60
POST_FILL_VERIFY_RETRY_DELAYS_SECONDS=2,5,10,20
POST_FILL_VERIFY_TELEGRAM_ON_VERIFIED=false

# STEP 10-4 — Telegram Operations Center (조회·알림·승인, 자동 주문 금지)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPS_ENABLED=false
TELEGRAM_OPS_POLL_INTERVAL_SECONDS=3
# 쉼표 구분 Chat ID whitelist (비어 있으면 모든 운영 명령 거부)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFICATION_LEVEL=INFO
TELEGRAM_WEBHOOK_SECRET=

SETTLEMENT_EQUITY_TOLERANCE_KRW=100
SETTLEMENT_PRICE_MAX_AGE_SECONDS=3600
SETTLEMENT_PAUSE_ACCOUNT_ON_CRITICAL_MISMATCH=true
UPBIT_DAILY_SETTLEMENT_ENABLED=true
UPBIT_DAILY_SETTLEMENT_HOUR=0
UPBIT_DAILY_SETTLEMENT_MINUTE=10
MARKET_SESSION_CRON_WAKEUP_ENABLED=true

# STEP 8-5-12 — Upbit Client Identifier / Ambiguous Resolver
UPBIT_CLIENT_ORDER_IDENTIFIER_ENABLED=true
UPBIT_AMBIGUOUS_RESOLVER_ENABLED=true
UPBIT_AMBIGUOUS_LOOKUP_INITIAL_DELAY_SECONDS=2
UPBIT_AMBIGUOUS_LOOKUP_MAX_ATTEMPTS=5
UPBIT_AMBIGUOUS_LOOKUP_MAX_AGE_SECONDS=120
UPBIT_AMBIGUOUS_LOOKUP_BACKOFF_SECONDS=2
UPBIT_ORDER_AUTO_RESUBMIT_ENABLED=false
UPBIT_ORDER_IDEMPOTENCY_ENABLED=true
UPBIT_ORDER_IDEMPOTENCY_TTL_HOURS=24
# STEP 8-5-14 — Upbit Ambiguous Resolver Scheduler (DB Claim / Distributed Lock)
# Remote 조회만 수행 — 자동 재제출 없음
UPBIT_AMBIGUOUS_RESOLVER_POLL_SECONDS=5
UPBIT_AMBIGUOUS_RESOLVER_BATCH_SIZE=20
UPBIT_AMBIGUOUS_RESOLVER_CLAIM_SECONDS=60
UPBIT_AMBIGUOUS_MAX_ORDERS_PER_ACCOUNT_PER_RUN=5
UPBIT_AMBIGUOUS_LOOKUP_MAX_INTERVAL_SECONDS=60
UPBIT_AMBIGUOUS_RESOLVER_RUN_HISTORY_DAYS=30

# ---------------------------------------------------------------------------
# STEP60 — Windows 운영 참고
# - 비밀 파일: E:\StockTrading\secrets\stock-platform.env
# - 운영 템플릿: ops/env.production.example
# - 스크립트: ops\start_server.bat / backup_db.bat / update_project.bat
# - 서비스: ops\install_nssm_service.ps1
# - 문서: INSTALL.md / OPERATIONS.md / README_STEP60.md
# ---------------------------------------------------------------------------

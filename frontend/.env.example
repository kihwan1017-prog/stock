NEXT_PUBLIC_APP_NAME=KIKI AI Trading Platform
# 빈 값 또는 same-origin = 브라우저 same-origin (/api → Next rewrite → backend)
# 절대 URL(http://127.0.0.1:8000)은 휴대폰 LAN에서 localhost=휴대폰 자신 이라 실패함
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false
# JWT 백엔드 인증 (개발 우회 모드 제거됨)
NEXT_PUBLIC_AUTH_MODE=backend
# Admin 기본 Paper 계좌 (하드코딩 분산 방지)
NEXT_PUBLIC_DEFAULT_PAPER_ACCOUNT_ID=1
